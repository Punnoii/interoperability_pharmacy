[PrefixDeclaration] 
:               http://example.com/idmp-demo/
idmp-mprd:      https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/
idmp-sub:       https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/
idmp-dtp:       https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO21090-HarmonizedDatatypes/
cmns-id:        https://www.omg.org/spec/Commons/Identifiers/
cmns-dsg:       https://www.omg.org/spec/Commons/Designators/
cmns-txt:       https://www.omg.org/spec/Commons/TextDatatype/
cmns-rlcmp:     https://www.omg.org/spec/Commons/RolesAndCompositions/
lcc-639-1:      https://www.omg.org/spec/LCC/Languages/ISO639-1-LanguageCodes/
rdf:            http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:           http://www.w3.org/2000/01/rdf-schema#
xsd:            http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId FdaMedicinalProduct
target :fda/product/{product_id} a idmp-mprd:MedicinalProduct .
source  SELECT product_id
        FROM postgres.fda_ndc_json.ndc_fda_product
        WHERE finished = true

mappingId FdaMedicinalProductIdentifierIdentifies
target :fda/mpid/US-NDC-{product_ndc} cmns-id:identifies :fda/product/{product_id} .
source  SELECT product_id , product_ndc
        FROM postgres.fda_ndc_json.ndc_fda_product
        WHERE finished = true
         AND product_ndc IS NOT NULL

mappingId FdaMedicinalProductIdentifierValue
target :fda/mpid/US-NDC-{product_ndc} cmns-txt:hasTextValue "{product_ndc}"^^xsd:string .
source SELECT product_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product
       WHERE finished = true
         AND product_ndc IS NOT NULL

mappingId FdaMedicinalProductIdentifierType
target :fda/mpid/US-NDC-{product_ndc} a idmp-mprd:MedicinalProductIdentifier .
source SELECT product_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product
       WHERE finished = true
         AND product_ndc IS NOT NULL

mappingId FdaMedicinalProductIdentifierLink
target :fda/product/{product_id} cmns-id:isIdentifiedBy :fda/mpid/US-NDC-{product_ndc} .
source SELECT product_id,
              product_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product
       WHERE finished = true
         AND product_ndc IS NOT NULL

mappingId FdaMedicinalProductNameLink
target :fda/product/{product_id} cmns-dsg:hasName :fda/product-name/{product_id} .
source  SELECT product_id
        FROM postgres.fda_ndc_json.ndc_fda_product
        WHERE finished = true
         AND (brand_name IS NOT NULL OR generic_name IS NOT NULL)

mappingId FdaMedicinalProductNameType
target :fda/product-name/{product_id} a idmp-mprd:MedicinalProductName .
source  SELECT product_id
        FROM postgres.fda_ndc_json.ndc_fda_product
        WHERE finished = true
         AND (brand_name IS NOT NULL OR generic_name IS NOT NULL)

mappingId FdaMedicinalProductNameValue
target  :fda/product-name/{product_id} idmp-mprd:hasFullMedicinalProductName "{product_name}"^^xsd:string .
source  SELECT product_id,COALESCE(brand_name, generic_name) AS product_name
        FROM postgres.fda_ndc_json.ndc_fda_product
        WHERE finished = true
         AND (brand_name IS NOT NULL OR generic_name IS NOT NULL)

mappingId FdaPackagedMedicinalProductType
target  :fda/package/{package_ndc} a idmp-mprd:PackagedMedicinalProduct .
source  SELECT pkg.package_ndc
        FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
        JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
        WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL

mappingId FdaPackagedMedicinalProductDefinedIn
target :fda/package/{package_ndc} cmns-dsg:isDefinedIn :fda/product/{product_id} .
source  SELECT pkg.product_id , pkg.package_ndc
        FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
        JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
        WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL

mappingId FdaPackagedMedicinalProductDescription
target  :fda/package/{package_ndc} cmns-dsg:hasDescription "{package_description}"^^xsd:string .
source SELECT pkg.package_ndc,
              pkg.package_description
       FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
       WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL
         AND pkg.package_description IS NOT NULL

mappingId FdaPackageIdentifierIdentifies
target :fda/pcid/US-NDC-{package_ndc} cmns-id:identifies :fda/package/{package_ndc} .
source SELECT pkg.package_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
       WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL

mappingId FdaPackageIdentifierValue
target :fda/pcid/US-NDC-{package_ndc} cmns-txt:hasTextValue "{package_ndc}"^^xsd:string .
source SELECT pkg.package_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
       WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL

mappingId FdaPackageIdentifierType
target :fda/pcid/US-NDC-{package_ndc} a idmp-mprd:PackageIdentifier .
source SELECT pkg.package_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
       WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL

mappingId FdaPackageIdentifierLink
target :fda/package/{package_ndc} cmns-id:isIdentifiedBy :fda/pcid/US-NDC-{package_ndc} .
source SELECT pkg.package_ndc
       FROM postgres.fda_ndc_json.ndc_fda_product_package pkg
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = pkg.product_id
       WHERE p.finished = true
         AND pkg.package_ndc IS NOT NULL

mappingId FdaSubstanceType
target :fda/substance/{product_id}/{ingredient_order} a idmp-sub:Substance .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaSubstanceNameType
target :fda/substance-name/{product_id}/{ingredient_order} a idmp-sub:SubstanceName .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaSubstanceNameLink
target :fda/substance/{product_id}/{ingredient_order} idmp-sub:hasSubstanceName :fda/substance-name/{product_id}/{ingredient_order} .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaSubstanceNameValue
target :fda/substance-name/{product_id}/{ingredient_order} idmp-sub:hasSubstanceNameValue "{ingredient_name}"^^xsd:string .
source SELECT i.product_id,
              i.ingredient_order,
              i.ingredient_name
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaActiveIngredientType
target :fda/active-ingredient/{product_id}/{ingredient_order} a idmp-sub:ActiveIngredient .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaActiveIngredientPlayedBy
target :fda/active-ingredient/{product_id}/{ingredient_order} cmns-rlcmp:isPlayedBy :fda/substance/{product_id}/{ingredient_order} .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaMedicinalProductHasActiveIngredient
target :fda/product/{product_id} idmp-mprd:hasActiveIngredient :fda/active-ingredient/{product_id}/{ingredient_order} .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL

mappingId FdaSubstanceUniiIdentifierType
target :fda/unii/{product_id}/{ingredient_order} a idmp-sub:SubstanceIdentifier .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product_unii_candidate u
         ON u.product_id = i.product_id
        AND u.unii_order = i.ingredient_order
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL
         AND u.unii IS NOT NULL

mappingId FdaSubstanceUniiIdentifierValue
target :fda/unii/{product_id}/{ingredient_order} cmns-txt:hasTextValue "{unii}"^^xsd:string .
source SELECT i.product_id,
              i.ingredient_order,
              u.unii
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product_unii_candidate u
         ON u.product_id = i.product_id
        AND u.unii_order = i.ingredient_order
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL
         AND u.unii IS NOT NULL

mappingId FdaSubstanceUniiIdentifierLink
target :fda/substance/{product_id}/{ingredient_order} cmns-id:isIdentifiedBy :fda/unii/{product_id}/{ingredient_order} .
source SELECT i.product_id,
              i.ingredient_order
       FROM postgres.fda_ndc_json.ndc_fda_product_ingredient i
       JOIN postgres.fda_ndc_json.ndc_fda_product_unii_candidate u
         ON u.product_id = i.product_id
        AND u.unii_order = i.ingredient_order
       JOIN postgres.fda_ndc_json.ndc_fda_product p
         ON p.product_id = i.product_id
       WHERE p.finished = true
         AND i.ingredient_name IS NOT NULL
         AND u.unii IS NOT NULL    

mappingId GsrsSubstanceType
target :gsrs/substance/{unii} a idmp-sub:Substance .
source SELECT unii
       FROM postgres.gsrs.substance
       WHERE unii IS NOT NULL
         AND status = 'approved' 
]]