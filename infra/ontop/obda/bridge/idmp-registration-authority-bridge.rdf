<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#">

  <!--
    Lightweight runtime bridge for Ontop.

    The full ISO11238-RegistrationAuthorities ontology imports large reference
    ABox datasets such as language and country codes. Those imported datasets
    currently trigger an Ontop 5.5.0 mapping-union/saturation error at runtime.

    For the now, we only need Ontop to know that the specific
    registration-authority identifier classes used by the OBDA mappings are
    subclasses of idmp-sub:SubstanceCode.

    The IRIs below intentionally match the official IDMP-O classes.
  -->
  <owl:Ontology rdf:about="https://example.org/idmp-demo/ontology/registration-authority-bridge">
    <rdfs:label>IDMP registration authority lightweight runtime bridge</rdfs:label>
    <rdfs:comment>
      Minimal Ontop runtime bridge containing only the subclass axioms required
      for substance-code identifier mappings.
    </rdfs:comment>
  </owl:Ontology>

  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/NorthAmericanJurisdiction/NorthAmericanRegistrationAuthorities/UniqueIngredientNumber">
    <rdfs:label>unique ingredient number</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceCode"/>
  </owl:Class>

  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/NorthAmericanJurisdiction/NorthAmericanRegistrationAuthorities/CASRegistryNumber">
    <rdfs:label>CAS registry number</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceCode"/>
  </owl:Class>

  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/NorthAmericanJurisdiction/NorthAmericanRegistrationAuthorities/MedicalSubjectHeadingsUniqueIdentifier">
    <rdfs:label>medical subject headings unique identifier</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceCode"/>
  </owl:Class>

  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/EuropeanJurisdiction/EuropeanRegistrationAuthorities/ChemicalEntitiesOfBiologicalInterestIdentifier">
    <rdfs:label>Chemical Entities of Biological Interest identifier</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceCode"/>
  </owl:Class>

  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/EuropeanJurisdiction/EuropeanRegistrationAuthorities/EudraVigilanceCode">
    <rdfs:label>EudraVigilance code</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceCode"/>
  </owl:Class>

</rdf:RDF>
