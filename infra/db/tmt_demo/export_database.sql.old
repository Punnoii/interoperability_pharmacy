CREATE CACHED TABLE PUBLIC.TMT(
    TPUCODE INT SELECTIVITY 100,
    ACTIVEINGREDIENT VARCHAR(512) SELECTIVITY 5,
    STRENGTH VARCHAR(512) SELECTIVITY 9,
    DOSAGEFORM VARCHAR(512) SELECTIVITY 2,
    CONTVALUE VARCHAR(512) SELECTIVITY 1,
    CONTUNIT VARCHAR(512) SELECTIVITY 1,
    DISPUNIT VARCHAR(512) SELECTIVITY 1,
    TRADENAME VARCHAR(512) SELECTIVITY 75,
    MANUFACTURER VARCHAR(512) SELECTIVITY 26,
    FSN VARCHAR(512) SELECTIVITY 100,
    STATUS VARCHAR(512) SELECTIVITY 1,
    COUNTRY VARCHAR(50) SELECTIVITY 1
);               
