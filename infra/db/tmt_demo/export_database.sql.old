CREATE USER IF NOT EXISTS SA SALT '2df41196d6c86516' HASH '6628f02a3be7b29a58113a80d82f2d17d3919719f7792f460923429a633e42e7' ADMIN;            
CREATE CACHED TABLE PUBLIC.ARTICLE57PRODUCT(
    "PRODUCT NAME" VARCHAR(512) SELECTIVITY 62,
    "ActiveSubstance" VARCHAR(512) SELECTIVITY 12,
    "ROUTE OF ADMINISTRATION" VARCHAR(512) SELECTIVITY 2,
    AUTHORISATIONCOUNTRY VARCHAR(512) SELECTIVITY 3,
    "MARKETING AUTHORISATION HOLDER" VARCHAR(512) SELECTIVITY 34,
    "PHARMACOVIGILANCE SYSTEM MASTER FILE LOCATION" VARCHAR(512) SELECTIVITY 2,
    "PHARMACOVIGILANCE ENQUIRIES EMAIL ADDRESS" VARCHAR(512) SELECTIVITY 20,
    "PHARMACOVIGILANCE ENQUIRIES TELEPHONE NUMBER" VARCHAR(512) SELECTIVITY 24,
    ID INT SELECTIVITY 100
);    
