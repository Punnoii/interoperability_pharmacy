[PrefixDeclaration]
:            http://example.com/idmp-demo/
idmp-sub:    https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/
idmp-dtp:    https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO21090-HarmonizedDatatypes/
cmns-id:     https://www.omg.org/spec/Commons/Identifiers/
cmns-dsg:    https://www.omg.org/spec/Commons/Designators/
cmns-txt:    https://www.omg.org/spec/Commons/TextDatatype/
lcc-639-1:   https://www.omg.org/spec/LCC/Languages/ISO639-1-LanguageCodes/
rdf:         http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:        http://www.w3.org/2000/01/rdf-schema#
xsd:         http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[
mappingId Substance
target :substance/{substance_id} a idmp-sub:Substance .
source SELECT substance_id
       FROM public.substance

mappingId SubstanceType
target :substance/{substance_id} idmp-sub:hasSubstanceType <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceTypeClassifier-Chemical> .
source SELECT substance_id
       FROM public.substance

mappingId SubstanceNameNode
target :substance-name/{name_id} a idmp-sub:SubstanceName ; idmp-sub:hasSubstanceNameValue "{name_value}"^^xsd:string ; idmp-sub:hasSubstanceNameType <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/SubstanceNameClassifier-PreferredName> ; idmp-dtp:hasLanguageCode <https://www.omg.org/spec/LCC/Languages/ISO639-1-LanguageCodes/en> .
source SELECT name_id,
       name_value
       FROM public.substance_name

mappingId SubstanceNameLink
target :substance/{substance_id} idmp-sub:hasSubstanceName :substance-name/{name_id} .
source SELECT substance_id,
       name_id
       FROM public.substance_name

mappingId SubstanceIdentifierNode
target :substance-identifier/{identifier_id} a idmp-sub:SubstanceIdentifier ; cmns-txt:hasTextValue "{identifier_value}"^^xsd:string .
source SELECT identifier_id,
       identifier_value
       FROM public.substance_identifier

mappingId SubstanceIdentifierLink
target :substance/{substance_id} cmns-id:isIdentifiedBy :substance-identifier/{identifier_id} .
source SELECT substance_id,
       identifier_id
       FROM public.substance_identifier
]]
